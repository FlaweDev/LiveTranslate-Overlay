{
  "general": {
    // Путь к главному скрипту-мосту относительно корня приложения
    "pythonScriptPath": "engine/ipc/bridge.py",
    "pytorch": {
      // Автоматически проверять и докачивать torch + torchaudio при старте
      "autoInstall": true,
      // Версия CUDA-сборки PyTorch: "cu126" | "cu124" | "cu121" | "cu118" | "cpu"
      "cudaVersion": "cu126",
      // Базовый URL индекса пакетов PyTorch (если не задан customIndexUrl, склеивается с cudaVersion)
      "indexBaseUrl": "https://download.pytorch.org/whl",
      // Полный кастомный URL индекса (оставьте пустым для автоматической генерации)
      "customIndexUrl": "",
      // Список устанавливаемых пакетов
      "packages": ["torch", "torchaudio"]
    }
  },
  "models": {
    // Общая папка для хранения и скачивания всех моделей (относительно корня или абсолютный путь)
    "defaultDirectory": "models",
    // Показывать ли окно подтверждения перед скачиванием отсутствующих моделей
    "requireDownloadConfirmation": true,

    "asr": {
      "name": "Multitalker Parakeet Streaming 0.6B v1",
      "filename": "multitalker-parakeet-streaming-0.6b-v1.nemo",
      // Если указан существующий путь к файлу или папке, модель берется оттуда / качается туда
      "overridePath": "",
      "downloadUrl": "https://huggingface.co/nvidia/multitalker-parakeet-streaming-0.6b-v1/resolve/main/multitalker-parakeet-streaming-0.6b-v1.nemo",
      "launchParameters": {
        // Устройство: "cuda" | "cpu"
        "device": "cuda",
        // Точность вычислений: "float16" | "float32" | "bfloat16"
        "computeType": "float16",
        "attContextSize": [70, 13],
        "maxSpeakers": 4,
        "idleStepsThreshold": 4
      }
    },

    "diarization": {
      "name": "Streaming Sortformer 4spk v2.1",
      "filename": "diar_streaming_sortformer_4spk-v2.1.nemo",
      "overridePath": "",
      "downloadUrl": "https://huggingface.co/nvidia/diar_streaming_sortformer_4spk-v2.1/resolve/main/diar_streaming_sortformer_4spk-v2.1.nemo",
      "launchParameters": {
        "binaryDiarPreds": false,
        "cacheGating": true,
        "cacheGatingBufferSize": 2
      }
    },

    "llm": {
      "name": "tower-plus-2b@q5_k_m",
      "filename": "tower-plus-2b-q5_k_m.gguf",
      "overridePath": "",
      "downloadUrl": "https://huggingface.co/DZgas/Tower-Plus-2B-GGUF/resolve/main/Tower-Plus-2B.Q5_K_M.gguf",
      "launchParameters": {
        "nCtx": 2048,
        // GPU Offload: 0 = только CPU, -1 = все слои на GPU, >0 = конкретное число слоев
        "nGpuLayers": 0,
        // CPU Thread Pool Size
        "nThreads": 4,
        // Max Concurrent Predictions (количество параллельных запросов)
        "maxConcurrentPredictions": 1,
        // Offload KV Cache to GPU Memory (false = хранить KV-кэш в ОЗУ)
        "offloadKqv": false,
        // Reasoning Budget (думающий режим): false = отключено
        "enableThinking": false,
        // Temperature: 0.0 = детерминированный (greedy) вывод
        "temperature": 0.0,
        // Limit Response Length (максимум генерируемых токенов)
        "maxTokens": 128,
        // Stop Strings: последовательности, при генерации которых вывод обрывается
        "stopStrings": ["(Note:", "\n"],
        // Top K Sampling
        "topK": 20,
        // Top P Sampling: 1.0 = отключено (false)
        "topP": 1.0,
        // Min P Sampling: 0.0 = отключено (false)
        "minP": 0.0,
        // Repeat Penalty: 1.0 = штраф отключен (false)
        "repeatPenalty": 1.0
      }
    }
  },
  "translation": {
    // Провайдер перевода: "LlamaCpp" (встроенный движок) | "RemoteApi" (внешний сервер: LM Studio, Ollama, OpenAI)
    "provider": "LlamaCpp",
    // Язык оригинала и целевой язык перевода (подставляются в promptTemplate)
    "sourceLanguage": "English",
    "targetLanguage": "Russian",
    // Шаблон промпта. Доступные плейсхолдеры: {source_lang}, {target_lang}, {text}
    "promptTemplate": "Translate the following {source_lang} source text to {target_lang}: {text} \n{target_lang}:",
    
    "remoteApi": {
      "baseUrl": "http://localhost:1234/v1",
      "endpoint": "/chat/completions",
      // API ключ (оставьте пустым для локальных серверов без авторизации)
      "apiKey": "",
      "modelName": "tower-plus-2b@q5_k_m",
      "timeoutSeconds": 30
    }
  },
  "ui": {
    "overlay": {
      "fontSizeMultiplier": 0.014,
      "windowHeightDivisor": 3.0,
      "maxCharactersPerSubtitle": 60,
      "maxCharactersPerTranslation": 100,
      "speakerColors": [
        "#FDEEAA",
        "#B3FCE4",
        "#FFC8C8",
        "#DAB5FF"
      ]
    },
    "animation": {
      "subtitleAppearDurationMs": 600,
      "subtitleDisappearDurationMs": 400,
      "verticalShiftDurationMs": 650,
      "wordFadeInDurationMs": 300,
      "sentenceFadeOutDurationMs": 750,
      "subtitleTimeoutMs": 3500,
      "horizontalShiftPixelsPerSecond": 220.0,
      "minHorizontalShiftDurationMs": 1000,
      "maxHorizontalShiftDurationMs": 3200
    }
  }
}