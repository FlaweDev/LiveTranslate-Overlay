<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LiveTranslateOverlay</RootNamespace>
    <AssemblyName>LiveTranslateOverlay</AssemblyName>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Publishing)' == 'true' or '$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(Publishing)' == 'true' or $(Configuration) == 'Release'">
    <RuntimeHostConfigurationOption Include="APP_PATHS" Value="lib" />
    <RuntimeHostConfigurationOption Include="NATIVE_DLL_SEARCH_DIRECTORIES" Value="lib" />  
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <Target Name="MoveLibrariesToLibFolder" AfterTargets="Publish">
    <ItemGroup>
      <CoreRuntimeFiles Include="$(PublishDir)$(AssemblyName).dll;
                                 $(PublishDir)hostfxr.dll;
                                 $(PublishDir)hostpolicy.dll;
                                 $(PublishDir)coreclr.dll;
                                 $(PublishDir)clrjit.dll;
                                 $(PublishDir)System.Private.CoreLib.dll" />

      <FilesToMove Include="$(PublishDir)*.dll;$(PublishDir)*.pdb"
                   Exclude="@(CoreRuntimeFiles)" />
    </ItemGroup>

    <MakeDir Directories="$(PublishDir)lib" />
    <Move SourceFiles="@(FilesToMove)" DestinationFolder="$(PublishDir)lib" OverwriteReadOnlyFiles="true" />
    <Delete Files="$(PublishDir)$(AssemblyName).deps.json" />
  </Target>
</Project>
